// 6. Running Text
class AnnouncementTicker extends StatelessWidget {
  final List<Map<String, dynamic>> items;

  const AnnouncementTicker({super.key, required this.items});

  Color _parseColor(String? hex) {
    if (hex == null || hex.isEmpty) return AppColors.accentOrange;
    var value = hex.replaceAll('#', '');
    if (value.length == 6) value = 'FF';
    try {
      return Color(int.parse(value, radix: 16));
    } catch (_) {
      return AppColors.accentOrange;
    }
  }

  @override
  Widget build(BuildContext context) {
    if (items.isEmpty) return const SizedBox.shrink();

    final texts = items
        .map((e) => (e['text'] ?? '').toString())
        .where((t) => t.trim().isNotEmpty)
        .toList();
    if (texts.isEmpty) return const SizedBox.shrink();

    final mergedText = texts.join('   �   ');
    final barColor = _parseColor(items.first['color']?.toString());

    return Container(
      width: double.infinity,
      height: 40,
      clipBehavior: Clip.hardEdge,
      decoration: BoxDecoration(
        color: barColor.withOpacity(0.08),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: barColor.withOpacity(0.3)),
      ),
      child: Row(
        children: [
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 8),
            color: barColor,
            height: double.infinity,
            alignment: Alignment.center,
            child: const Icon(
              Icons.campaign_rounded,
              color: Colors.white,
              size: 20,
            ),
          ),
          Expanded(
            child: ClipRect(
              child: SingleChildScrollView(
                scrollDirection: Axis.horizontal,
                child: Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 12),
                  child: Center(
                    child: Text(
                      mergedText,
                      style: const TextStyle(
                        color: AppColors.textDark,
                        fontWeight: FontWeight.w500,
                        fontSize: 13,
                      ),
                      maxLines: 1,
                      overflow: TextOverflow.visible,
                      softWrap: false,
                    ),
                  ),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
}



